---
import { useTranslations, normalizeLocale } from '@/lib/i18n';

interface Props {
  locale?: string;
}

const { locale } = Astro.props;
const t = useTranslations(normalizeLocale(locale));
---
<button class="search-trigger" id="search-trigger" aria-label={t('search.open')}>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
    <circle cx="11" cy="11" r="7"/>
    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </svg>
  <span class="search-label">Search docs...</span>
  <kbd>&#8984;K</kbd>
</button>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 7px 14px;
    cursor: pointer;
    width: 280px;
    max-width: 100%;
    min-width: 0;
    transition: border-color 0.2s;
  }
  .search-trigger:hover {
    border-color: var(--text-3);
  }

  .search-trigger kbd {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 500;
    color: var(--text-3);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
    margin-left: auto;
  }

  @media (max-width: 767px) {
    .search-trigger {
      width: 32px;
      height: 32px;
      padding: 0;
      justify-content: center;
      flex-shrink: 0;
      background: none;
      border-color: transparent;
    }
    .search-trigger svg {
      width: 20px;
      height: 20px;
    }
    .search-label,
    .search-trigger kbd {
      display: none;
    }
  }
</style>
