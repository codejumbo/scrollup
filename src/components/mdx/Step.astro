---
interface Props {
  num: number;
  title: string;
}

const { num, title } = Astro.props;
---

<div class="proc-step">
  <div class="proc-num">{num}</div>
  <div class="proc-body">
    <h4>{title}</h4>
    <slot />
  </div>
</div>

<style>
  .proc-step {
    display: grid;
    grid-template-columns: 36px 1fr;
    margin-bottom: 20px;
  }

  .proc-num {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 700;
    color: var(--text-3);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--border);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .proc-body { padding-top: 3px; }
  .proc-body h4 {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }
  .proc-body :global(p) {
    font-size: 14.5px;
    color: var(--text-2);
    line-height: 1.6;
    margin-bottom: 0;
  }
</style>
