---
// No props — content is driven entirely by the slot (nested markdown lists).
---

<div class="file-tree">
  <slot />
</div>

<script>
  // SVG icon templates
  const ICONS: Record<string, string> = {
    dir: `<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 4.5A1.5 1.5 0 0 1 3 3h2.879a1.5 1.5 0 0 1 1.06.44L8 4.5H13A1.5 1.5 0 0 1 14.5 6v6A1.5 1.5 0 0 1 13 13.5H3A1.5 1.5 0 0 1 1.5 12V4.5z"/></svg>`,
    file: `<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 1.5h-7A1 1 0 0 0 1.5 2.5v11A1 1 0 0 0 2.5 14.5h11A1 1 0 0 0 14.5 13.5V6L9.5 1.5z"/><polyline points="9.5 1.5 9.5 6.5 14.5 6.5"/></svg>`,
    ts:   `<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect width="16" height="16" rx="2" fill="#3178c6"/><path d="M10.574 11.753v1.388c.226.117.494.205.804.266.311.06.637.09.978.09.33 0 .647-.035.95-.104a2.26 2.26 0 0 0 .793-.34c.228-.157.41-.362.547-.614.137-.252.205-.558.205-.918 0-.254-.038-.477-.114-.669a1.572 1.572 0 0 0-.333-.513 2.266 2.266 0 0 0-.527-.39 5.337 5.337 0 0 0-.694-.317 8.08 8.08 0 0 1-.46-.195.888.888 0 0 1-.283-.194.344.344 0 0 1-.09-.238c0-.083.023-.156.07-.22a.46.46 0 0 1 .2-.148.835.835 0 0 1 .316-.054c.12 0 .245.018.374.054.129.036.254.09.376.163.121.073.228.162.32.268V8.9a3.272 3.272 0 0 0-.688-.198 4.337 4.337 0 0 0-.774-.067c-.323 0-.633.038-.929.114a2.27 2.27 0 0 0-.776.356 1.729 1.729 0 0 0-.527.607c-.13.247-.195.54-.195.876 0 .434.122.8.366 1.099.244.298.617.548 1.119.75l.492.198c.155.063.285.127.389.194.104.066.182.14.234.22a.465.465 0 0 1 .077.267.36.36 0 0 1-.072.224.494.494 0 0 1-.204.155.85.85 0 0 1-.325.057 1.93 1.93 0 0 1-.42-.048 2.13 2.13 0 0 1-.42-.147 2.106 2.106 0 0 1-.379-.254zm-2.908-3.027H9.5V7.5h-5v1.226h1.834V13.5h1.332V8.726z" fill="#fff"/></svg>`,
    js:   `<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect width="16" height="16" rx="2" fill="#f7df1e"/><path d="M6.002 11.464c.185.332.435.576.784.576.334 0 .547-.132.547-.645V7.714h1.25v3.7c0 1.063-.623 1.547-1.531 1.547-.82 0-1.296-.424-1.538-.936l.488-.561zm3.531-.106c.23.377.528.655 1.054.655.443 0 .726-.221.726-.527 0-.366-.29-.496-.78-.708l-.268-.115c-.772-.329-1.285-.743-1.285-1.615 0-.803.612-1.415 1.568-1.415.681 0 1.17.236 1.523.854l-.664.426c-.183-.327-.382-.456-.659-.456-.3 0-.49.19-.49.456 0 .319.19.448.63.645l.268.114c.91.39 1.422.788 1.422 1.68 0 .963-.756 1.491-1.771 1.491-.992 0-1.633-.473-1.944-1.095l.67-.39z" fill="#333"/></svg>`,
    json: `<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="#e8a12a" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 4C4 4 3 4.5 3 6v1c0 1-.5 1.5-1.5 1.5S1 8.5 1 8.5 1.5 9 1.5 9.5V10.5c0 1.5 1 2 2 2M11 4c1 0 2 .5 2 2v1c0 1 .5 1.5 1.5 1.5S15 8.5 15 8.5s-.5.5-.5 1V10.5c0 1.5-1 2-2 2"/></svg>`,
    css:  `<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect width="16" height="16" rx="2" fill="#264de4"/><path d="M3.5 13.5 2.5 3.5h11l-1 10-4 1.5-4-1.5zm8.5-8.5H4l.167 2h7.166L11.333 9H7l.083 1.5L8 11l.917-.5L9 9h2.25L11 12 8 13l-3-1-.25-2.5h1.5l.167 1.5L8 11.5l1.583-.5.167-2H5.083L4.75 7h6.5L11 5z" fill="#fff"/></svg>`,
    html: `<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect width="16" height="16" rx="2" fill="#e44d26"/><path d="M3 2.5l1 9 4 1.5 4-1.5 1-9H3zm7.167 7.5L8 10.75 5.833 10l-.25-2.5h1.334l.166 1.5L8 9.5l.917-.5.167-1.5H4.75l-.25-3h7l-.083 1H5.5l.083 1H11l-.333 3z" fill="#fff"/></svg>`,
    astro:`<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M10.2 3.4C9.5 5 8.1 6.8 6.5 7.8c.2-.7.3-1.4.3-2.2 0-1.4-.5-2.6-1.4-3.6C6 3.6 6.3 5 6.3 6.5c0 1-.2 2-.6 2.8C5.3 8 4.9 6.7 4.9 5.4c0-.6.1-1.2.2-1.7C4.2 4.8 3.8 6 3.8 7.3c0 2.3 1.4 4.2 3.5 5 2.2.8 4.6-.1 5.9-2C14 8.7 13.5 5.2 10.2 3.4z" fill="#ff5d01"/></svg>`,
    md:   `<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="#57a7a7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="14" height="10" rx="1.5"/><path d="M3.5 10V6l2 2.5L8 6v4M10 10V6M12 8h-2"/></svg>`,
    mdx:  `<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="#57a7a7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="14" height="10" rx="1.5"/><path d="M3.5 10V6l2 2.5L8 6v4M10 10V6M12 8h-2"/></svg>`,
    svg:  `<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect width="16" height="16" rx="2" fill="#ffb13b"/><circle cx="5.5" cy="8" r="2" fill="none" stroke="#333" stroke-width="1.2"/><path d="M10 6l2 2-2 2M13 8h-4" stroke="#333" stroke-width="1.2" stroke-linecap="round" fill="none"/></svg>`,
  };

  // Extension → icon key
  const EXT_MAP: Record<string, string> = {
    ts: 'ts', tsx: 'ts', 'd.ts': 'ts',
    js: 'js', mjs: 'js', cjs: 'js', jsx: 'js',
    json: 'json', jsonc: 'json',
    css: 'css', scss: 'css', sass: 'css',
    html: 'html', htm: 'html',
    astro: 'astro',
    md: 'md', mdx: 'mdx', mdoc: 'md',
    svg: 'svg',
  };

  function getIconKey(filename: string): string {
    // Handle compound extensions like d.ts
    const compound = filename.match(/\.([^.]+\.[^.]+)$/)?.[1];
    if (compound && EXT_MAP[compound]) return EXT_MAP[compound];
    const ext = filename.split('.').pop()?.toLowerCase() ?? '';
    return EXT_MAP[ext] ?? 'file';
  }

  document.querySelectorAll('.file-tree').forEach((tree) => {
    tree.querySelectorAll('li').forEach((li) => {
      // Get the first meaningful text (the filename)
      let text = '';
      for (const node of li.childNodes) {
        if (node.nodeName === 'UL') continue;
        if (node.nodeType === Node.TEXT_NODE) {
          const t = node.textContent?.trim() ?? '';
          if (t) { text = t; break; }
        } else {
          text = (node as Element).textContent?.trim() ?? '';
          break;
        }
      }

      const isDir = !!li.querySelector(':scope > ul') || text.endsWith('/');
      const isPlaceholder = text === '...' || text === '…';

      if (isDir) li.dataset.ft = 'dir';
      if (isPlaceholder) li.dataset.ft = 'placeholder';

      // Wrap inline comments (text after the first element)
      let foundFirst = false;
      for (const node of [...li.childNodes]) {
        if (node.nodeName === 'UL') continue;
        if (!foundFirst) {
          if (
            node.nodeType === Node.ELEMENT_NODE ||
            (node.nodeType === Node.TEXT_NODE && node.textContent?.trim())
          ) {
            foundFirst = true;
          }
        } else if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
          const span = document.createElement('span');
          span.className = 'ft-comment';
          span.textContent = node.textContent;
          node.replaceWith(span);
        }
      }

      // Inject icon
      if (!isPlaceholder) {
        const iconKey = isDir ? 'dir' : getIconKey(text.replace(/\/$/, ''));
        const icon = document.createElement('span');
        icon.className = 'ft-icon';
        icon.innerHTML = ICONS[iconKey] ?? ICONS.file;
        li.prepend(icon);
      }
    });
  });
</script>

<style>
  .file-tree {
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.7;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    background: var(--bg-surface);
    padding: 18px 20px;
    margin: 28px 0;
    overflow-x: auto;
  }

  .file-tree :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .file-tree :global(li) {
    position: relative;
    padding-left: 1.6em;
    color: var(--text-2);
  }

  /* Icon span — sits in the left padding area */
  .file-tree :global(.ft-icon) {
    position: absolute;
    left: 0;
    top: 0.28em;
    width: 1em;
    height: 1em;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-3);
  }

  .file-tree :global(.ft-icon svg) {
    width: 100%;
    height: 100%;
  }

  /* Placeholder (... or …) */
  .file-tree :global(li[data-ft="placeholder"]) {
    color: var(--text-3);
  }

  /* Inline comment */
  .file-tree :global(.ft-comment) {
    color: var(--text-3);
    padding-left: 0.75em;
  }

  /* Bold = highlighted/current file */
  .file-tree :global(li > strong),
  .file-tree :global(li > p > strong) {
    color: var(--accent);
    font-weight: 600;
  }

  /* em = legacy placeholder syntax */
  .file-tree :global(li > em),
  .file-tree :global(li > p > em) {
    color: var(--text-3);
    font-style: normal;
  }

  /* Inline code */
  .file-tree :global(li code) {
    font-family: var(--mono);
    font-size: inherit;
    background: none;
    padding: 0;
    color: inherit;
  }

  /* Connector lines */
  .file-tree :global(ul ul) {
    padding-left: 1.6em;
    border-left: 1px solid var(--border);
    margin-left: 0.5em;
    margin-top: 0;
  }

  /* Horizontal connector from vertical line to each nested item */
  .file-tree :global(ul ul > li)::after {
    content: '';
    position: absolute;
    left: -1.5em;
    top: 0.85em;
    width: 1.3em;
    height: 1px;
    background: var(--border);
  }
</style>
