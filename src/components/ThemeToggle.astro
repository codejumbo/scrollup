---
import { useTranslations, normalizeLocale } from '@/lib/i18n';

interface Props {
  locale?: string;
}

const { locale } = Astro.props;
const t = useTranslations(normalizeLocale(locale));
---
<button
  class="icon-btn theme-toggle"
  id="theme-toggle"
  title={t('theme.system')}
  aria-label={t('theme.system')}
  data-label-light={t('theme.light')}
  data-label-system={t('theme.system')}
  data-label-dark={t('theme.dark')}
>
  <svg class="theme-icon" id="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
  <svg class="theme-icon" id="theme-icon-system" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
  <svg class="theme-icon" id="theme-icon-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
</button>

<script>
  type ThemePref = 'light' | 'system' | 'dark';

  function getPreference(): ThemePref {
    // One-time migration from old 'theme' key
    if (typeof localStorage !== 'undefined') {
      const pref = localStorage.getItem('theme-preference');
      if (pref === 'light' || pref === 'system' || pref === 'dark') return pref;

      const oldTheme = localStorage.getItem('theme');
      if (oldTheme === 'light' || oldTheme === 'dark') {
        localStorage.setItem('theme-preference', oldTheme);
        localStorage.removeItem('theme');
        return oldTheme;
      }
    }
    return 'system';
  }

  function resolveTheme(pref: ThemePref): 'light' | 'dark' {
    if (pref === 'system') {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    return pref;
  }

  function applyTheme(pref: ThemePref) {
    const resolved = resolveTheme(pref);
    if (resolved === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    localStorage.setItem('theme-preference', pref);

    // Update icon visibility
    const lightIcon = document.getElementById('theme-icon-light');
    const systemIcon = document.getElementById('theme-icon-system');
    const darkIcon = document.getElementById('theme-icon-dark');
    if (lightIcon) lightIcon.style.display = pref === 'light' ? 'block' : 'none';
    if (systemIcon) systemIcon.style.display = pref === 'system' ? 'block' : 'none';
    if (darkIcon) darkIcon.style.display = pref === 'dark' ? 'block' : 'none';

    // Update aria-label from data-* attributes (locale-aware, set at render time)
    const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
    if (btn) {
      const nextLabel: Record<ThemePref, string> = {
        light: btn.dataset.labelSystem ?? 'Use system theme',
        system: btn.dataset.labelDark ?? 'Switch to dark theme',
        dark: btn.dataset.labelLight ?? 'Switch to light theme',
      };
      btn.setAttribute('aria-label', nextLabel[pref]);
    }
  }

  function cycleTheme() {
    const current = getPreference();
    const next: Record<ThemePref, ThemePref> = {
      light: 'system',
      system: 'dark',
      dark: 'light',
    };
    applyTheme(next[current]);
  }

  function setup() {
    applyTheme(getPreference());
    document.getElementById('theme-toggle')?.addEventListener('click', cycleTheme);
  }

  setup();
  document.addEventListener('astro:after-swap', setup);

  // Listen for system preference changes (only matters when preference is 'system')
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getPreference() === 'system') {
      applyTheme('system');
    }
  });
</script>

<style>
  .icon-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    color: var(--text-3);
    cursor: pointer;
    border-radius: var(--radius);
    transition: color 0.15s, background 0.15s;
    font-size: 15px;
  }
  .icon-btn:hover {
    color: var(--text-2);
    background: var(--bg-surface);
  }

  .theme-icon {
    display: none;
  }
</style>
