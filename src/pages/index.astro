---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Topbar from '@/components/Topbar.astro';
import SearchDialog from '@/components/SearchDialog.astro';
import ThemeInit from '@/components/ThemeInit.astro';
import SEOHead from '@/components/SEOHead.astro';
import Footer from '@/components/Footer.astro';
import { getSiteName, socialIcons } from '@/lib/config';
import { resolvedConfig as siteConfig, globalHeadTags } from '@/lib/resolved-config';

const extLinkIcon = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>';
const escapeAttr = (v: string) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={`${getSiteName('en')} — ${siteConfig.description}`} />
  <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
  <title>{getSiteName('en')}</title>
  <SEOHead title={getSiteName('en')} description={siteConfig.description} url={siteConfig.siteUrl} />
  {siteConfig.customCss.map((href) => <link rel="stylesheet" href={href} />)}
  {globalHeadTags.map((tag) => (
    <Fragment set:html={`<${tag.tag}${Object.entries(tag.attrs ?? {}).map(([k, v]) => ` ${k}="${escapeAttr(v)}"`).join('')}>${tag.content ?? ''}</${tag.tag}>`} />
  ))}
  <ClientRouter />
  <ThemeInit />
</head>
<body>
  <Topbar variant="branded" hideSearch />
  <SearchDialog />

  <main class="landing">

    <!-- Hero Banner -->
    <section class="hero">
      <div class="hero-bg">
        <div class="hero-grid"></div>
      </div>
      <div class="hero-content">
        <div class="hero-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          Open source · MIT License
        </div>
        <h1>Beautiful Documentation,<br/>Effortlessly</h1>
        <p class="hero-sub">
          An open-source documentation framework built on Astro.
          Write in MDX, customize with tokens, and ship fast — with full-text search,
          dark mode, i18n-ready routing, and a polished reading experience out of the box.
        </p>
        <div class="hero-actions">
          <a href="/en/getting-started/introduction" class="btn-primary">Get started</a>
          <a href="/en/getting-started/installation" class="btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            Quick setup
          </a>
        </div>
        <div class="hero-search" id="hero-search-trigger">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span>Search documentation...</span>
          <kbd>⌘K</kbd>
        </div>
        <script is:inline>
          document.getElementById('hero-search-trigger')?.addEventListener('click', function() {
            document.dispatchEvent(new CustomEvent('open-search'));
          });
        </script>
      </div>
    </section>

    <!-- Feature Highlights -->
    <section class="features">
      <div class="features-inner">

        <div class="features-header">
          <h2>Everything you need. Nothing you don't.</h2>
          <p>Built for developers and technical writers who want beautiful, fast documentation without fighting the tool.</p>
        </div>

        <div class="features-bento">

          <!-- MDX — hero card, spans 2 cols -->
          <div class="feat feat-mdx">
            <div class="feat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3>Write in MDX</h3>
            <p>Full Markdown and JSX component support. Drop in callouts, tabs, steps, accordions, and code blocks directly in your content — no plugins to configure.</p>
            <div class="feat-code-preview" aria-hidden="true">
              <div class="fcp-chrome">
                <span class="fcp-dot"></span><span class="fcp-dot"></span><span class="fcp-dot"></span>
                <span class="fcp-filename">getting-started.mdx</span>
              </div>
              <div class="fcp-body">
                <div class="fcp-line"><span class="fcp-tag">&lt;Callout</span> <span class="fcp-attr">type</span><span class="fcp-eq">=</span><span class="fcp-str">"tip"</span><span class="fcp-tag">&gt;</span></div>
                <div class="fcp-line fcp-indent"><span class="fcp-text">Run </span><span class="fcp-code">npm run dev</span><span class="fcp-text"> to start the dev server.</span></div>
                <div class="fcp-line"><span class="fcp-tag">&lt;/Callout&gt;</span></div>
                <div class="fcp-line fcp-mt"><span class="fcp-tag">&lt;Steps&gt;</span></div>
                <div class="fcp-line fcp-indent"><span class="fcp-tag">&lt;Step&gt;</span><span class="fcp-text">Install dependencies</span><span class="fcp-tag">&lt;/Step&gt;</span></div>
                <div class="fcp-line fcp-indent"><span class="fcp-tag">&lt;Step&gt;</span><span class="fcp-text">Configure your site</span><span class="fcp-tag">&lt;/Step&gt;</span></div>
                <div class="fcp-line"><span class="fcp-tag">&lt;/Steps&gt;</span></div>
              </div>
            </div>
          </div>

          <div class="feat feat-search">
            <div class="feat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <h3>Instant full-text search</h3>
            <p>Client-side search powered by Orama. Zero external services, zero API keys. The index builds at compile time and runs entirely in the browser.</p>
            <div class="feat-search-preview" aria-hidden="true">
              <div class="fsp-bar">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span class="fsp-query">frontmatter</span>
                <kbd>⌘K</kbd>
              </div>
              <div class="fsp-results">
                <div class="fsp-result fsp-result--active">
                  <span class="fsp-section">API reference</span>
                  <span class="fsp-title">Frontmatter schema</span>
                </div>
                <div class="fsp-result">
                  <span class="fsp-section">Authoring</span>
                  <span class="fsp-title">Markdown &amp; MDX</span>
                </div>
                <div class="fsp-result">
                  <span class="fsp-section">Getting started</span>
                  <span class="fsp-title">Configuration</span>
                </div>
              </div>
            </div>
          </div>

          <div class="feat feat-dark">
            <div class="feat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </div>
            <h3>Dark mode, done right</h3>
            <p>Three-state toggle: light, system, dark. Colors are hand-picked — not an automated inversion — so both themes look intentional.</p>
            <div class="feat-theme-chips" aria-hidden="true">
              <span class="theme-chip theme-chip--light">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                Light
              </span>
              <span class="theme-chip theme-chip--system">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                System
              </span>
              <span class="theme-chip theme-chip--dark">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                Dark
              </span>
            </div>
          </div>

          <div class="feat feat-i18n">
            <div class="feat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <h3>i18n built in</h3>
            <p>Six locales ship out of the box with translated UI chrome. Add a language by dropping files into <code>content/docs/{'{locale}'}/</code>.</p>
            <div class="feat-locale-chips" aria-hidden="true">
              <span class="locale-chip">en</span>
              <span class="locale-chip">fr</span>
              <span class="locale-chip">es</span>
              <span class="locale-chip">de</span>
              <span class="locale-chip">ja</span>
              <span class="locale-chip">hi</span>
            </div>
          </div>

          <div class="feat feat-design">
            <div class="feat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </div>
            <h3>Design-first</h3>
            <p>Every decision — 860px content width, serif body type, warm off-white — was made for readability. Polished without touching a CSS variable.</p>
          </div>

          <!-- Deploy — full-width card -->
          <div class="feat feat-deploy">
            <div class="feat-deploy-body">
              <div class="feat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <h3>Deploy anywhere</h3>
              <p>Generates pure static HTML — no server, no runtime, no lock-in. Automated CI/CD workflows included for every major platform.</p>
            </div>
            <div class="feat-deploy-platforms">

              <span class="platform-tag">
                <svg width="12" height="10" viewBox="0 0 116 100" fill="currentColor" aria-hidden="true"><path d="M57.5 0L115 100H0L57.5 0Z"/></svg>
                Vercel
              </span>

              <span class="platform-tag">
                <svg width="13" height="13" viewBox="0 0 40 40" fill="currentColor" aria-hidden="true"><path d="M0 40V0h8L32 28V0h8v40h-8L8 12V40z"/></svg>
                Netlify
              </span>

              <span class="platform-tag">
                <svg width="16" height="10" viewBox="0 0 54 34" fill="currentColor" aria-hidden="true"><path d="M35 6.3A13 13 0 0 0 9.5 12.7 8.8 8.8 0 0 0 1 21.5 8.8 8.8 0 0 0 9.8 30.3h28.4a7.1 7.1 0 0 0 0-14.2 6.5 6.5 0 0 0-.9.06A13 13 0 0 0 35 6.3z"/></svg>
                Cloudflare Pages
              </span>

              <span class="platform-tag">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                GitHub Pages
              </span>

              <span class="platform-tag">
                <svg width="14" height="13" viewBox="0 0 380 380" fill="currentColor" aria-hidden="true"><path d="M190 340L353 108 315 8H65L27 108z"/><path d="M190 340L27 108 0 190z" opacity="0.7"/><path d="M190 340L353 108 380 190z" opacity="0.7"/></svg>
                GitLab Pages
              </span>

              <span class="platform-tag">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                Self-hosted
              </span>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="use-cases">
      <div class="use-cases-inner">
        <h2>Who uses ScrollUp?</h2>
        <div class="use-cases-grid">
          <div class="use-case">
            <h3>Developer tools & libraries</h3>
            <p>Document your API, SDK, or CLI with structured reference pages, code blocks, and an endpoint component built for technical readers.</p>
          </div>
          <div class="use-case">
            <h3>SaaS products</h3>
            <p>Ship user-facing documentation alongside your product. The clean design and dark mode keep enterprise readers comfortable across long sessions.</p>
          </div>
          <div class="use-case">
            <h3>Internal knowledge bases</h3>
            <p>Version-controlled docs in a Git repo, with full-text search and a sidebar that builds itself from your file structure. No CMS required.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Portal Cards -->
    <section class="portal-cards">
      <div class="portal-header">
        <h2>Browse the documentation</h2>
      </div>
      <div class="cards-grid">

        <!-- Getting Started -->
        <div class="portal-card">
          <div class="card-header">
            <svg class="card-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
            <h2>Getting started</h2>
          </div>
          <div class="card-divider"></div>
          <ul class="card-links">
            <li><a href="/en/getting-started/introduction">Introduction</a></li>
            <li><a href="/en/getting-started/installation">Installation</a></li>
            <li><a href="/en/getting-started/configuration">Configuration</a></li>
            <li><a href="/en/getting-started/project-structure">Project structure</a></li>
            <li><a href="/en/getting-started/your-first-docs-site">Your first docs site</a></li>
            <li><a href="/en/getting-started/troubleshooting">Troubleshooting</a></li>
          </ul>
        </div>

        <!-- Authoring Content -->
        <div class="portal-card">
          <div class="card-header">
            <svg class="card-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            <h2>Authoring content</h2>
          </div>
          <div class="card-divider"></div>
          <ul class="card-links">
            <li><a href="/en/authoring/markdown-and-mdx">Markdown &amp; MDX</a></li>
            <li><a href="/en/authoring/frontmatter-schema">Frontmatter schema</a></li>
            <li><a href="/en/authoring/built-in-components">Built-in components</a></li>
            <li><a href="/en/authoring/advanced-components">Advanced components</a></li>
            <li><a href="/en/authoring/code-blocks">Code blocks</a></li>
            <li><a href="/en/authoring/notes-and-asides">Notes &amp; asides</a></li>
          </ul>
        </div>

        <!-- Theming & Customization -->
        <div class="portal-card">
          <div class="card-header">
            <svg class="card-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <h2>Theming &amp; customization</h2>
          </div>
          <div class="card-divider"></div>
          <ul class="card-links">
            <li><a href="/en/theming/colors-and-typography">Colors &amp; typography</a></li>
            <li><a href="/en/theming/dark-mode">Dark mode</a></li>
            <li><a href="/en/theming/layout-and-navigation">Layout &amp; navigation</a></li>
            <li><a href="/en/theming/custom-css">Custom CSS</a></li>
          </ul>
        </div>

        <!-- Internationalization -->
        <div class="portal-card">
          <div class="card-header">
            <svg class="card-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <h2>Internationalization</h2>
          </div>
          <div class="card-divider"></div>
          <ul class="card-links">
            <li><a href="/en/internationalization/adding-a-language">Adding a language</a></li>
