{
  "name": "scrollup.io",
  "version": "1.0.0",
  "description": "Open-source documentation template built on Astro",
  "author": "Codejumbo LLC",
  "license": "MIT",
  "homepage": "https://github.com/codejumbo/scrollup",
  "repository": {
    "type": "git",
    "url": "https://github.com/codejumbo/scrollup"
  },
  "bugs": {
    "url": "https://github.com/codejumbo/scrollup/issues"
  },
  "keywords": [
    "documentation",
    "astro",
    "mdx",
    "template",
    "static-site-generator",
    "docs",
    "search",
    "dark-mode"
  ],
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "setup": "node scripts/setup.mjs",
    "check-links": "npx tsx scripts/check-links.ts",
    "validate": "npx astro check && npm run check-links",
    "new-page": "node scripts/new-page.mjs",
    "check-content": "npx tsx scripts/check-content.ts",
    "check-freshness": "npx tsx scripts/check-freshness.ts",
    "pre-commit": "bash scripts/pre-commit.sh",
    "pre-commit:fast": "bash scripts/pre-commit.sh --skip-build",
    "generate-skill": "npx tsx scripts/generate-skill.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "zod": "^4.3.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@orama/orama": "^3.1.18",
    "astro": "^6.1.3",
    "astro-expressive-code": "^0.41.7",
    "mermaid": "^11.14.0",
    "remark-emoji": "^5.0.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "typescript": "^5.9.3"
  }
}
